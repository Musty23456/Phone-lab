name: Build Windows Executable

on:
  push:
    branches: [ "main", "master" ]
    tags: [ "v*" ]
  pull_request:
    branches: [ "main", "master" ]
  workflow_dispatch: {}

jobs:
  build:
    name: Build ALMUS PHONE LAB (Windows)
    runs-on: windows-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Python dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run test suite
        run: |
          pip install pytest
          python -m pytest tests -v

      - name: Download Android Platform Tools
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"
          $url = "https://dl.google.com/android/repository/platform-tools-latest-windows.zip"
          $zipPath = Join-Path $env:RUNNER_TEMP "platform-tools.zip"
          Write-Host "Downloading platform-tools from $url"
          try {
            Invoke-WebRequest -Uri $url -OutFile $zipPath -UseBasicParsing
            Expand-Archive -Path $zipPath -DestinationPath $env:RUNNER_TEMP -Force
            $extracted = Join-Path $env:RUNNER_TEMP "platform-tools"
            New-Item -ItemType Directory -Force -Path "tools\platform-tools" | Out-Null
            Copy-Item -Path (Join-Path $extracted "*") -Destination "tools\platform-tools" -Recurse -Force
            Write-Host "Platform tools installed into tools\platform-tools"
          } catch {
            Write-Warning "Could not download platform-tools automatically ($_). The app will still build and will fall back to system PATH / user-configured paths at runtime."
          }

      - name: Verify project structure
        shell: pwsh
        run: |
          Write-Host "Project root contents:"
          Get-ChildItem -Force
          Write-Host "`nApp package contents:"
          Get-ChildItem -Recurse -Path app -Include *.py | Select-Object -First 50 FullName

      - name: Build with PyInstaller
        run: |
          python -m PyInstaller ALMUS_PHONE_LAB.spec --noconfirm

      - name: Assemble release folder
        shell: pwsh
        run: |
          $dist = "dist\ALMUS_PHONE_LAB"
          if (-not (Test-Path $dist)) {
            throw "PyInstaller output not found at $dist"
          }
          Copy-Item -Path "README.md" -Destination (Join-Path $dist "README.txt") -Force
          Copy-Item -Path "LICENSE" -Destination (Join-Path $dist "LICENSE.txt") -Force
          Write-Host "Final dist contents:"
          Get-ChildItem -Recurse $dist | Select-Object -First 100 FullName

      - name: Download Visual C++ Runtime
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force -Path redist | Out-Null
          try {
            Invoke-WebRequest -Uri "https://aka.ms/vs/17/release/vc_redist.x64.exe" -OutFile "redist\vc_redist.x64.exe" -UseBasicParsing
          } catch {
            Write-Warning "Could not download VC++ runtime ($_). Installer will be built without it."
          }

      - name: Build installer (Inno Setup)
        shell: pwsh
        run: |
          choco install innosetup -y --no-progress
          $iscc = "${env:ProgramFiles(x86)}\Inno Setup 6\ISCC.exe"
          & $iscc "installer\ALMUS_PHONE_LAB.iss"
          if ($LASTEXITCODE -ne 0) { throw "Inno Setup failed" }

      - name: Package ZIP
        shell: pwsh
        run: |
          Compress-Archive -Path "dist\ALMUS_PHONE_LAB" -DestinationPath "ALMUS_PHONE_LAB_Windows.zip" -Force

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: ALMUS_PHONE_LAB_Windows
          path: ALMUS_PHONE_LAB_Windows.zip
          if-no-files-found: error
          retention-days: 30

      - name: Upload installer artifact
        uses: actions/upload-artifact@v4
        with:
          name: ALMUS_PHONE_LAB_Setup
          path: installer_output/ALMUS_PHONE_LAB_Setup.exe
          if-no-files-found: error
          retention-days: 30
