/* ALMUS PHONE LAB - Dark Professional Theme */

* {
    font-family: "Segoe UI", "Cascadia Code", Arial, sans-serif;
    font-size: 13px;
    color: #E6E8EB;
}

QMainWindow, QWidget#CentralWidget {
    background-color: #14161A;
}

/* ---- Sidebar ---- */
QWidget#Sidebar {
    background-color: #101216;
    border-right: 1px solid #22262E;
}

QLabel#BrandTitle {
    color: #4FD1C5;
    font-size: 18px;
    font-weight: 700;
    padding: 18px 16px 2px 16px;
}

QLabel#BrandSubtitle {
    color: #7A8290;
    font-size: 11px;
    padding: 0 16px 16px 16px;
}

QPushButton#NavButton {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 10px 18px;
    border-left: 3px solid transparent;
    color: #C4C9D2;
    font-size: 13px;
}

QPushButton#NavButton:hover {
    background-color: #1B1F26;
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background-color: #1B222B;
    border-left: 3px solid #4FD1C5;
    color: #4FD1C5;
    font-weight: 600;
}

/* ---- Top device status bar ---- */
QWidget#TopBar {
    background-color: #181B21;
    border-bottom: 1px solid #22262E;
}

QLabel#TopBarTitle {
    font-size: 15px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#StatusDot {
    font-size: 16px;
}

/* ---- Cards ---- */
QFrame[class="Card"] {
    background-color: #1B1F26;
    border: 1px solid #262B33;
    border-radius: 10px;
}

QLabel[class="CardTitle"] {
    font-size: 13px;
    font-weight: 600;
    color: #9AA4B2;
    text-transform: uppercase;
}

QLabel[class="CardValue"] {
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
}

QLabel[class="SectionHeader"] {
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    padding: 4px 0 8px 0;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #232833;
    border: 1px solid #2E3542;
    border-radius: 6px;
    padding: 8px 14px;
    color: #E6E8EB;
}

QPushButton:hover {
    background-color: #2B3240;
    border-color: #3A4353;
}

QPushButton:pressed {
    background-color: #1E232C;
}

QPushButton:disabled {
    color: #5A6070;
    background-color: #1A1D23;
}

QPushButton#PrimaryButton {
    background-color: #2F8F80;
    border: 1px solid #37A896;
    color: #06110F;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #37A896;
}

QPushButton#DangerButton {
    background-color: #7A2A2A;
    border: 1px solid #9C3A3A;
    color: #FFEDED;
    font-weight: 600;
}

QPushButton#DangerButton:hover {
    background-color: #942F2F;
}

/* ---- Inputs ---- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: #12151A;
    border: 1px solid #2A2F38;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #2F8F80;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border-color: #4FD1C5;
}

/* ---- Terminal-style output ---- */
QPlainTextEdit#TerminalOutput {
    background-color: #0B0D10;
    color: #B7F7C4;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    border: 1px solid #22262E;
    border-radius: 8px;
}

/* ---- Tables ---- */
QTableWidget {
    background-color: #14171C;
    gridline-color: #22262E;
    border: 1px solid #22262E;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #1B1F26;
    color: #9AA4B2;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #262B33;
}

QTableWidget::item:selected {
    background-color: #24303A;
}

/* ---- Progress bar ---- */
QProgressBar {
    background-color: #12151A;
    border: 1px solid #2A2F38;
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4FD1C5;
    border-radius: 6px;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: #14161A;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #2A2F38;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #3A4353;
}

QTabWidget::pane {
    border: 1px solid #22262E;
    border-radius: 6px;
}

QTabBar::tab {
    background: #1B1F26;
    padding: 8px 14px;
    border: 1px solid #22262E;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #24303A;
    color: #4FD1C5;
}
